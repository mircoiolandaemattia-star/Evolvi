# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
# credenziali e config ambiente: NON vanno nel repo. Solo .env.example
# e' versionato (serve da documentazione); .env e .env.production si
# configurano a mano nel dashboard (Render per il backend, Vercel per la
# PWA). Nota: le env del dashboard VINCONO su .env.production ( Expo non
# sovrascrive cio' che e' gia' definito in process.env ).
/.env*
!/.env.example

# typescript
*.tsbuildinfo

# backend compilato (build su Render)
dist-server/

# client Prisma generato (rigenerato con `npx prisma generate`)
# senza `output` in schema.prisma finisce in node_modules/.prisma/client
# (già coperto da node_modules/); /generated/ copre un eventuale output a root
/generated/

example

# generated native folders
/ios
/android

# Skill e tool locali
/.opencode/
/.idea/

# Password DB locali (non versionare mai)
.dbpasswd.txt
skills-lock.json
.agents/
__pycache__/
